# Server-only: no VITE_ prefix. Read in server code with process.env.APP_ORIGIN.
APP_ORIGIN=http://localhost:3000
AUTH_PUBLIC_ORIGIN=http://localhost:8081
AUTH_GATEWAY_ORIGIN=http://localhost:8081

# Client-visible: VITE_ prefix. Read with import.meta.env.VITE_APP_NAME.
# These values are public and included in the browser bundle. Never put secrets here.
VITE_APP_NAME=Trapigo Dashboard

# Keep real server secrets in the Git-ignored .env.local or deployment environment.
# Example server-only variable: AUTH_SECRET (read with process.env.AUTH_SECRET).